    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
