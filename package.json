{
  "name": "rulebookguard",
  "version": "0.0.0",
  "description": "Keep business rules as the single source of truth, bound to code and tests.",
  "license": "MIT",
  "bin": {
    "rulebookguard": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
